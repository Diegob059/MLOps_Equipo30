# ==============================================================================
# MiBici MLOps - .gitignore
# ==============================================================================

# Data (Excluir datos locales de gran volumen preservando la estructura de carpetas)
/data/raw/*
!/data/raw/.gitkeep
/data/interim/*
!/data/interim/.gitkeep
/data/processed/*
!/data/processed/.gitkeep
/data/external/*
!/data/external/.gitkeep

# Modelos Serializados y Artefactos de Entrenamiento
/models/*
!/models/.gitkeep
*.pkl
*.joblib
*.onnx

# MLflow Tracking y Artefactos de Experimentos
mlruns/
mlartifacts/
**/mlruns/
**/mlartifacts/
.mlflow/
mlflow.db
*.db

# Figuras generadas dinámicamente en reportes
/reports/figures/*
!/reports/figures/.gitkeep

# Variables de Entorno y Secretos
.env
.env.*
!.env.example

# Archivos específicos de sistemas operativos
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editores y entornos de desarrollo
.vscode/
.idea/
*.swp
*.swo
*~

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Python compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing y Cobertura
.pytest_cache/
.coverage
htmlcov/
.tox/
.ruff_cache/