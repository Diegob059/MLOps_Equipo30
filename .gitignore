# ==============================================================================
# MiBici MLOps - .gitignore (CCDS v1)
# ==============================================================================

# Datos locales y binarios
/data/raw/*
/data/interim/*
/data/processed/*
/data/external/*
!/data/**/.gitkeep

# Modelos Serializados y Artefactos de Entrenamiento
/models/*
!/models/.gitkeep
*.pkl
*.joblib
*.onnx

# Entornos y compilación
.env
.env.*
!.env.example
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
develop-eggs/
eggs/
.eggs/
*.egg

# Tests y linters
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# MLOps / MLflow
mlruns/
mlartifacts/
**/mlruns/
**/mlartifacts/
.mlflow/
*.db
*.sqlite
mlflow.db

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# IDEs y SO
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.vscode/
.idea/
*.swp
*.swo
*~
